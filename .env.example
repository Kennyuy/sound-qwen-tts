# 阿里云百炼 API Key
# 获取方式：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here

# 可选：自定义 API 基础 URL（通常不需要修改）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 可选：默认输出目录
# OUTPUT_DIR=./outputs

# 可选：默认音色
# DEFAULT_VOICE=longxiaochun

# 可选：默认语速 (0.5-2.0)
# DEFAULT_SPEED=1.0

# 可选：默认音调 (0.5-2.0)
# DEFAULT_PITCH=1.0

# 可选：默认音量 (0.1-1.0)
# DEFAULT_VOLUME=1.0
